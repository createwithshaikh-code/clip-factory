#!/usr/bin/env bash
# Shortcut: ./cf <command>  ==  .venv python -m clipfactory <command>  (macOS, Linux, Git Bash on Windows)
cd "$(dirname "$0")"
if [ -x .venv/bin/python ]; then PY=.venv/bin/python; elif [ -x .venv/Scripts/python.exe ]; then PY=.venv/Scripts/python.exe; else PY=python3; fi
exec "$PY" -m clipfactory "$@"
